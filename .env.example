# Copie este archivo como .env (está en .gitignore) y ajuste los valores.
#   cp .env.example .env

# --- Seguridad de las APIs (cabecera X-API-Key) ---
TRIAGE_API_KEY=cambie-esta-clave-triage
ASISTENTE_API_KEY=cambie-esta-clave-asistente

# --- Proveedor de IA (API compatible con OpenAI). La clave NUNCA se commitea. ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Alternativa 100% local con Ollama (ollama pull llama3.1 && ollama pull nomic-embed-text):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_CHAT_MODEL=llama3.1
# LLM_EMBEDDING_MODEL=nomic-embed-text
# RAG_UMBRAL_SIMILITUD=0.45   # los embeddings de cada proveedor tienen escalas distintas; ajustar si hace falta

# --- Base de datos ---
DB_PASSWORD=triaje

# --- Alertas de escalamiento (RF-06): webhook compatible con Slack / Teams. Vacío = solo log. ---
ALERTAS_WEBHOOK_URL=

# --- Monitor de SLA (RF-03): acorte los SLA para ver el escalamiento en segundos ---
ESCALAMIENTO_INTERVALO=15s
SLA_CRITICO=5m
SLA_URGENTE=10m
SLA_URGENTE_2=30m
SLA_NO_URGENTE=60m
SLA_NO_URGENTE_2=120m
